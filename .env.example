# ======================================================================
# JimiCode 配置模板（.env.example）
# 用法：复制为 .env 并填入你的真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，不会提交到仓库；.env.example 可提交
# ======================================================================

# ── 协议（必填）──────────────────────────────────────────────────────
# 取值：anthropic / openai / openai-compat
JimiCode_PROTOCOL=anthropic

# ── API 地址（可选，默认走官方地址）────────────────────────────────
# anthropic   -> https://api.anthropic.com
# openai      -> https://api.openai.com
JimiCode_BASE_URL=https://api.anthropic.com

# ── API Key（必填）───────────────────────────────────────────────────
# 也可以只用 ANTHROPIC_API_KEY 或 OPENAI_API_KEY 来命名
JimiCode_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── 模型（可选，默认 claude-sonnet-4-6 / gpt-4o）───────────────────
JimiCode_MODEL=claude-sonnet-4-6

# ── （可选）指定配置文件路径，优先级高于自动查找 ─────────────────
# JimiCode_CONFIG=D:/path/to/config.yaml

# ── 支持的更多变量，按需取消注释 ────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx   # 协议自动识别为 anthropic
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx          # 协议自动识别为 openai
